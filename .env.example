# Kizuna-AI Environment Variables Configuration

# -------------------------------------------------------------
# SUPABASE POSTGRESQL & REALTIME CONFIGURATION
# -------------------------------------------------------------
# Primary live database connection string from Supabase project settings -> Database
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# Supabase API credentials (Project Settings -> API)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-ANON-PUBLIC-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SERVICE-ROLE-KEY]

# -------------------------------------------------------------
# ADMIN DASHBOARD AUTHORIZATION
# -------------------------------------------------------------
ADMIN_PIN=1234
SESSION_SECRET=kizuno_admin_secret_key_2026

# -------------------------------------------------------------
# REAL GMAIL SMTP CONFIGURATION FOR CITIZEN EMAIL VERIFICATION
# -------------------------------------------------------------
SMTP_EMAIL=your_email@gmail.com
SMTP_APP_PASSWORD=your_16_digit_app_password
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465

